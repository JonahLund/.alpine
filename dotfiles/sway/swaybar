#!/bin/sh

while :; do
    cpu=$(uptime | awk -F'load average: ' '{print $2}' | cut -d, -f1)
    ram=$(free | awk '/^Mem:/ {printf "%.0f%%", $3/$2*100}')
    disk=$(df -h / | awk 'NR==2 {print $5}')

    printf '[CPU <b>%s</b>] [RAM <b>%s</b>] [DISK <b>%s</b>] %s\n' \
        "$cpu" "$ram" "$disk" "$(date '+%a %-d %b %H:%M')"

    sleep 5
done
