pkgname=dotlink
pkgver=0.3.0
pkgrel=0
pkgdesc="Mullvad VPN"
arch="x86_64"
license="MIT"
makedepends="cargo cargo-auditable"
url="https://github.com/TheRealLorenz/dotlink"
_commit=1656c94e84ec7bc11ed9dd651d135f9a7364ec19
source="
	$pkgname-$pkgver.tar.gz::https://github.com/TheRealLorenz/dotlink/archive/$_commit.tar.gz
"

prepare() {
	default_prepare

	cd "$srcdir/dotlink-$_commit"
	cargo fetch --locked
}

build() {
	cargo auditable build --release --frozen
}

check() {
	cargo test --frozen
}

package() {
	cd "$srcdir/dotlink-$_commit"
	install -Dm755 target/release/dotlink -t "$pkgdir"/usr/bin
}

sha512sums="
