pkgname=workstyle
pkgver=0.9.0
pkgrel=0
pkgdesc="Sway workspaces with style" 
arch="x86_64"
license="MIT"
makedepends="cargo cargo-auditable"
url="https://github.com/pierrechevalier83/workstyle"
_commit="dae15018c84c4f0feaf498d3676271ca0e3bec44"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/pierrechevalier83/workstyle/archive/$_commit.tar.gz
"

prepare() {
	default_prepare

	cd "$srcdir/workstyle-$_commit"
	cargo fetch --locked
}

build() {
	cargo auditable build --release --frozen
}

check() {
	cargo test --frozen
}

package() {
	cd "$srcdir/workstyle-$_commit"
	install -Dm755 target/release/workstyle -t "$pkgdir"/usr/bin
}

sha512sums="
8b1156a1cbe7c795b570a8cefe119e964b4b39645e0122faaeb890e8f400243251435aefd1cc322fb3c3f8d49c5ad48be2df0b1aff95e2b4e3eabd33474f2fd0  workstyle-0.9.0.tar.gz
"
