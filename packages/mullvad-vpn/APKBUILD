pkgname=mullvad-vpn
pkgver=2026.1
pkgrel=0
pkgdesc="Mullvad VPN"
arch="x86_64"
license="MIT"
makedepends="cargo protobuf-dev libmnl-dev dbus-dev libnftnl-dev"
url="https://github.com/mullvad/mullvadvpn-app"
subpackages="mullvad-vpn-cli:_split mullvad-vpn-daemon:_split mullvad-vpn-openrc"
source="
	$pkgname-$pkgver.tar.gz::https://github.com/mullvad/mullvadvpn-app/archive/$pkgver.tar.gz
  ./mullvad-daemon.confd
  ./mullvad-daemon.initd
"

export RUSTFLAGS="-Ctarget-feature=-crt-static"

prepare() {
	default_prepare

	cd "$srcdir/mullvadvpn-app-$pkgver"
	cargo fetch --locked
}

build() {
	cd "$srcdir/mullvadvpn-app-$pkgver"
	cargo build --locked --frozen --release \
		-p mullvad-daemon \
		-p mullvad-cli
}

check() {
	cd "$srcdir/mullvadvpn-app-$pkgver"
	cargo test --locked --frozen \
		-p mullvad-daemon \
		-p mullvad-cli
}

openrc() {
	local name=${subpkgname%-openrc}
	default_openrc
	depends="openrc mullvad-vpn-daemon"

	install -Dm755 "$srcdir"/mullvad-daemon.initd "$subpkgdir"/etc/init.d/mullvad-daemon
	install -Dm644 "$srcdir"/mullvad-daemon.confd "$subpkgdir"/etc/conf.d/mullvad-daemon
}

package() {
	cd "$srcdir/mullvadvpn-app-$pkgver"
  install -Dm755 "$srcdir/mullvadvpn-app-$pkgver"/target/release/mullvad "$pkgdir"/usr/bin/mullvad
  install -Dm755 "$srcdir/mullvadvpn-app-$pkgver"/target/release/mullvad-daemon "$pkgdir"/usr/bin/mullvad-daemon
}

_split() {
	case "$subpkgname" in
		mullvad-vpn-cli)
			pkgdesc="Mullvad VPN CLI"
			amove usr/bin/mullvad
			;;
		mullvad-vpn-daemon)
			pkgdesc="Mullvad VPN daemon"
			depends="libmnl-dev libnftnl-dev dbus-dev"
			amove usr/bin/mullvad-daemon
			;;
	esac
}

